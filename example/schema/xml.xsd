<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal offline stand-in for the W3C xml namespace schema, which the
     official TWB XSD imports without a schemaLocation. Only the attributes
     the TWB schema can reference are declared. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.w3.org/XML/1998/namespace"
           xmlns:xml="http://www.w3.org/XML/1998/namespace">
  <xs:attribute name="base" type="xs:anyURI"/>
  <xs:attribute name="lang" type="xs:string"/>
  <xs:attribute name="space" type="xs:string"/>
  <xs:attribute name="id" type="xs:ID"/>
</xs:schema>
