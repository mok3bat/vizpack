<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.vizpack.example" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name" />
    <description>Vizpack example — a self-contained Tableau data app (pure JS, bundled snapshot). Runs on Desktop, offline, and as a packaged site extension.</description>
    <author name="Vizpack" email="noreply@example.com" website="https://www.tableau.com" />
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>http://localhost:8750/index.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=</icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <encoding id="field">
      <display-name>Measure</display-name>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>discrete-measure</role-type>
      </role-spec>
      <fields max-count="10" />
      <encoding-icon token="level" />
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Vizpack Example</text>
    </resource>
  </resources>
</manifest>
